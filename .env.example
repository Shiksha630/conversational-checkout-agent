# Anthropic Claude API Key (Required for AI tool-calling agent)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Razorpay Test API Keys (Get from dashboard.razorpay.com in Test Mode)
# If left blank or default, the agent will operate in high-fidelity mock sandbox mode for instant demoing.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Server Port
PORT=5000
